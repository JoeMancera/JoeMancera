---
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
const { title, description } = Astro.props
---

<style is:global>
  :root {
    --color-white: var(--text-primary);
    --color-black: var(--bg-base);
    --color-grey: #494949;
    --color-light: var(--text-secondary);
    --color-primary: var(--accent-red);
    --color-secondary: var(--accent-blue);
    --color-link: var(--accent-blue);
    --color-vanilla: var(--text-primary);

    --font-family-body: 'Inter', sans-serif;
    --font-family-headings: 'Space Grotesk', sans-serif;
    --font-family: 'Inter', sans-serif;
    --font-headline1: 700 48px/62.4px var(--font-family-headings);
    --font-headline2: 700 36px/46.8px var(--font-family-headings);
    --font-headline3: 600 24px/31.2px var(--font-family-headings);
    --font-headline4: 500 18px/23.4px var(--font-family-body);
    --font-body: 400 18px/28px var(--font-family-body);
    --font-body-small: 400 18px/23.4px var(--font-family-body);
    --font-labels: 400 18px/23.4px var(--font-family);
    --font-button: 500 18px/23.4px var(--font-family-body);
    --font-link: 400 16px/20.8px var(--font-family-body);
    --font-link-menu: 300 18px/23.4px var(--font-family);
  }

  * {
    margin: 0;
  }

  body {
    font: var(--font-body);
    background: var(--color-black);
    color: var(--color-light);
    overflow-x: hidden;
  }

  h1 {
    font: var(--font-headline1);
    text-transform: none;
  }

  h2 {
    font: var(--font-headline2);
  }

  h3 {
    font: var(--font-headline3);
  }

  h4 {
    font: var(--font-headline4);
  }

  a {
    font: var(--font-link);
    text-decoration: none;
  }

  section {
    padding-inline-start: 20px;
    padding-inline-end: 20px;
  }

  .container {
    max-inline-size: 1158px;
    margin: 0 auto;
  }

  .section__title {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding-left: 21px;
    border-left: 3px solid var(--color-link);
  }

  .section__description {
    margin-top: 18px;
    margin-bottom: 25px;
  }

  @media only screen and (min-width: 560px) {
    .section__description {
      max-width: 500px;
      margin-bottom: 50px;
      margin-left: 28px;
    }
  }

  @media only screen and (min-width: 1024px) {
    section {
      padding-bottom: 80px;
    }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font: var(--font-button);
    border-radius: 12px;
    padding: 0.5rem 2rem;
    margin: 0.75rem 0;
    text-decoration: none;
    cursor: pointer;
    background-color: var(--color-white);
    border: 1px solid var(--color-link);
    color: var(--color-primary);
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .btn:hover {
    background-color: var(--color-link);
    color: var(--color-white);
  }

  .btn-secondary {
    background: transparent;
    border-color: var(--color-white);
    color: var(--color-secondary);
  }

  .btn-secondary:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
</style>

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:description" content={description} />
    <meta property="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    <meta property="og:image" content="" />
    <meta property="twitter:image" content="" />
    <meta property="og:title" content={title} />
    <meta property="twitter:title" content={title} />
    <meta property="og:url" content="" />
    <meta property="twitter:url" content="" />
    <meta property="og:type" content="website" />
    <meta property="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
