---
import { hobbies } from '../../utils/data/hobbies'
---

<section id="hobbies" class="container">
  <h2 class="section__title">Hobbies</h2>
  <p class="section__description">
    I want to share with you my hobbies and some of my favorite things.
  </p>
  <ul class="hobbies__container">
    {
      hobbies.map((hobby) => (
        <div class="hobby">
          <div class="hobby__description">
            <h3>{hobby.title}</h3>
          </div>
          <div class="hobby__image">
            <img src={`img/${hobby.image}`} alt="" loading="lazy" />
          </div>
        </div>
      ))
    }
  </ul>
</section>
<style>
  .hobbies__container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    padding: 0;
  }

  .hobby {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    margin-bottom: 50px;
  }

  .hobby__description {
    margin-bottom: 20px;
  }

  @media only screen and (min-width: 560px) {
    .hobbies__container {
      display: flex;
      justify-content: space-around;
    }
  }
</style>
