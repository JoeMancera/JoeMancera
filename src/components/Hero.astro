<main
  aria-label="main"
  id="main"
  class="container grid min-h-[calc(100vh-3rem)] gap-10 px-5 py-8 md:px-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:items-center"
>
  <figure class="flex justify-center lg:justify-start">
    <img
      class="h-[150px] w-[150px] rounded-full object-cover object-[50%_35%] md:h-[300px] md:w-[300px] lg:h-[200px] lg:w-[200px]"
      src="./img/hero.png"
      alt="Joe Mancera"
      loading="lazy"
    />
  </figure>

  <div class="flex flex-col justify-center gap-10">
    <div class="space-y-4 text-center md:text-left">
      <span
        class="hidden text-sm uppercase tracking-[0.35em] text-accent-blue md:inline-block"
      >
        Hello!
      </span>
      <h1
        class="text-4xl font-semibold leading-tight text-text-primary md:text-5xl lg:text-6xl"
      >
        I'm <span class="text-accent-red">Joe Mancera</span>
      </h1>
      <h2 class="text-xl font-medium text-accent-blue">Web developer</h2>
    </div>

    <div class="grid gap-8 md:grid-cols-[40%_60%] md:items-start">
      <p
        class="max-w-md text-base leading-[1.75] text-text-secondary border-b-2 border-accent-blue pb-4 md:text-xl md:leading-tight"
      >
        Developer who loves to implement designs that inspire and attract
        people.
      </p>

      <div class="flex flex-col justify-between gap-6">
        <div class="grid gap-4 sm:grid-cols-3">
          <a
            href="https://github.com/JoeMancera"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-3 text-text-primary transition hover:text-accent-red"
          >
            <img
              class="h-5 w-5"
              src="./img/GitHub-logo.svg"
              alt="GitHub"
              loading="lazy"
            />
            <span
              class="border-b border-transparent transition group-hover:border-accent-red"
              >GitHub</span
            >
          </a>
          <a
            href="https://www.linkedin.com/in/joemancera/"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-3 text-text-primary transition hover:text-accent-red"
          >
            <img
              class="h-5 w-5"
              src="./img/Linkedin-logo.svg"
              alt="LinkedIn"
              loading="lazy"
            />
            <span
              class="border-b border-transparent transition group-hover:border-accent-red"
              >LinkedIn</span
            >
          </a>
          <a
            href="https://twitter.com/JoeHarrym"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-3 text-text-primary transition hover:text-accent-red"
          >
            <img
              class="h-5 w-5"
              src="./img/Twitter-logo.svg"
              alt="Twitter"
              loading="lazy"
            />
            <span
              class="border-b border-transparent transition group-hover:border-accent-red"
              >Twitter</span
            >
          </a>
        </div>

        <a
          href="./assets/Joe Harry Mancera - Web Developer -EN-ES.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full items-center justify-center gap-2 rounded-md border border-accent-red bg-accent-red px-8 py-3 text-sm font-semibold text-text-primary transition hover:bg-accent-blue hover:border-accent-blue md:w-auto"
        >
          <img
            class="h-5 w-5"
            src="./img/Document-logo.svg"
            alt="Document icon"
          />
          Download curriculum
        </a>
      </div>
    </div>
  </div>
</main>
