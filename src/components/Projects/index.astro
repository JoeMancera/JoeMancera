---
import { projects } from '../../../utils/data/projects.js'
---

<style>
  .projects__container {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    justify-items: center;
    align-items: center;
    gap: 20px;
  }

  .project {
    min-width: 320px;
    max-with: 380px;
    background: #6a7b76;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    margin-bottom: 28px;
    height: 100%;
  }

  .project img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s;
  }

  .project:hover {
    box-shadow: 0 0 5px var(--color-vanilla);
  }

  .description {
    display: flex;
    flex-direction: column;
    padding: 15px;
  }

  .description h3 {
    margin: 0;
    color: var(--color-link);
    text-shadow: 0px 0px 2px var(--color-black);
  }

  .description p {
    color: var(--color-white);
    font-size: 16px;
    line-height: 28px;
    letter-spacing: 0.08em;
    text-shadow: 0px 0px 6px rgba(0, 34, 48, 0.4);
  }

  .button__group {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: auto;
  }

  .button__group a {
    margin-right: 10px;
  }

  @media only screen and (max-width: 1040px) {
    .projects__container {
      display: frid;
      grid-template-columns: 1fr 1fr;
    }
  }

  @media only screen and (max-width: 768px) {
    .projects__container {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
  }
</style>
<section id="projects" class="container">
  <h2 class="section__title">Projects</h2>
  <p class="section__description">
    I show you to me the best and important projects that I have. I think that
    this projects help me to know how do APIs, how implement that and do the
    interaction with the users.
  </p>
  <div class="projects__container">
    {
      projects.map((project) => (
        <div class="project" id={project.id}>
          <img alt={project.title} src={`/img/projects/${project.image}`} />
          <div class="main-info">
            <h3>{project.title}</h3>
          </div>
          <div class="description">
            <p>{project.description}</p>
            <div class="button__group">
              <a
                target="_blank"
                rel="noopener noreferrer"
                href={project.code}
                class="btn btn-primary"
              >
                See code
              </a>
              <a
                target="_blank"
                rel="noopener noreferrer"
                href={project.link}
                class="btn btn-secondary"
              >
                See app
              </a>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
