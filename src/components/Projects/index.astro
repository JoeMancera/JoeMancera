---
import { projects } from '../../../utils/data/projects.js'
---

<section id="projects" class="container py-10">
  <h2 class="section__title">Projects</h2>
  <p class="section__description">
    I show you to me the best and important projects that I have. I think that this projects help me to know how do APIs, how implement that and do the interaction with the users.
  </p>

  <div class="grid gap-6 lg:grid-cols-2">
    {
      projects.map((project) => (
        <article class="group overflow-hidden rounded-[16px] bg-bg-surface text-text-secondary shadow-[0_12px_30px_rgba(0,0,0,0.12)] transition duration-300 hover:-translate-y-1">
          <figure class="overflow-hidden aspect-[4/3]">
            <img class="h-full w-full object-cover transition duration-500 group-hover:scale-110" alt={project.title} src={`/img/projects/${project.image}`} />
          </figure>
          <div class="flex h-full flex-col gap-4 p-6">
            <h2 class="text-2xl font-semibold text-text-primary">{project.title}</h2>
            <p class="flex-1 leading-7">{project.description}</p>
            <a href={project.link} class="inline-flex items-center gap-2 text-accent-blue transition hover:text-accent-red focus:outline focus:outline-2 focus:outline-accent-blue">
              Read more
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>
