---
import { experience } from '../../utils/data/experience'
---

<section id="experience" class="container py-10">
  <h2 class="section__title">Experience</h2>
  <p class="section__description">
    I have been working as a web developer for more than 7 years, and I have been involved in many projects. I have working with many technologies and roles.
  </p>

  <ol class="space-y-10 pl-0 md:pl-8 pb-8">
    {
      experience.reverse().map((item) => (
        <li class="relative rounded-[20px] border border-accent-blue bg-bg-surface p-8 pl-16 text-text-primary shadow-[0_8px_30px_rgba(0,0,0,0.12)]">
          <span class="absolute left-0 top-6 inline-block h-7 w-7 rounded-full border-4 border-accent-blue bg-accent-red/20"></span>
          <h3 class="text-3xl font-semibold text-text-primary">{item.title}</h3>
          <span class="mt-3 flex flex-col gap-1 text-accent-blue">
            <span>{item.entity}</span>
            <span class="text-accent-yellow">{item.dateStart}-{item.dateEnd ?? 'Present'}</span>
          </span>
          <div class="mt-6 flex flex-col gap-3 text-text-secondary max-w-3xl">
            {item.descriptions.map((desc) => (
              <p>{desc}</p>
            ))}
          </div>
        </li>
      ))
    }
  </ol>
</section>
